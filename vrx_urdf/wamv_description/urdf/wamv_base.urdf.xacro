<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wam-v">
  <!-- Required arg for melodic and kinetic... -->
  <xacro:arg name="namespace" default="wamv"/>
  <xacro:property name="namespace" value="$(arg namespace)" scope="global" />
  <!-- Macro for creating the main collisions as simple shapes. -->
  <xacro:macro name="main_collisions" params="prefix reflect:=1">
    <!-- Main float -->
    <collision name="${prefix}_float">
      <origin xyz="-0.4 ${1.03*reflect} 0.2" rpy="${0*reflect} 1.57 0" />
      <geometry>
        <cylinder length="4" radius="0.2" />
      </geometry>
    </collision>

    <collision name="${prefix}_mid_float">
      <origin xyz="1.85 ${1.03*reflect} 0.3" rpy="${0*reflect} 1.38 0" />
      <geometry>
        <cylinder length="0.5" radius="0.17" />
      </geometry>
    </collision>
    <collision name="${prefix}_front_float">
      <origin xyz="2.3 ${1.03*reflect} 0.4" rpy="${0*reflect} 1.3 0" />
      <geometry>
        <cylinder length="0.45" radius="0.12" />
      </geometry>
    </collision>

    <!-- Front beam -->
    <collision name="front_${prefix}_beam_lower">
      <origin xyz="0.9 ${0.85*reflect} 1" rpy="${0.78*reflect} 0 0" />
      <geometry>
        <cylinder length="0.5" radius="0.04" />
      </geometry>
    </collision>

    <collision name="front_${prefix}_beam_upper">
      <origin xyz="0.9 ${0.6*reflect} 1.18" rpy="${1.35*reflect} 0 0" />
      <geometry>
        <cylinder length="0.2" radius="0.04" />
      </geometry>
    </collision>

    <!-- Mid beam -->
    <collision name="mid_${prefix}_beam_lower">
      <origin xyz="-0.65 ${0.99*reflect} 0.7" rpy="${0.1*reflect} 0.25 0" />
      <geometry>
        <cylinder length="0.45" radius="0.03" />
      </geometry>
    </collision>

    <collision name="mid_${prefix}_beam_medium">
      <origin xyz="-0.57 ${0.87*reflect} 1.05" rpy="${0.75*reflect} 0.25 0" />
      <geometry>
        <cylinder length="0.32" radius="0.03" />
      </geometry>
    </collision>

    <collision name="mid_${prefix}_beam_upper">
      <origin xyz="-0.55 ${0.65*reflect} 1.17" rpy="${1.35*reflect} 0.25 0" />
      <geometry>
        <cylinder length="0.3" radius="0.03" />
      </geometry>
    </collision>

    <!-- Rear beam -->
    <collision name="rear_${prefix}_beam_lower">
      <origin xyz="-0.74 ${1.03*reflect} 0.7" rpy="${0*reflect} -0.15 0" />
      <geometry>
        <cylinder length="0.45" radius="0.03" />
      </geometry>
    </collision>

    <collision name="rear_${prefix}_beam_medium">
      <origin xyz="-0.79 ${0.91*reflect} 1.05" rpy="${0.75*reflect} -0.15 0" />
      <geometry>
        <cylinder length="0.32" radius="0.03" />
      </geometry>
    </collision>

    <collision name="rear_${prefix}_beam_upper">
      <origin xyz="-0.81 ${0.67*reflect} 1.18" rpy="${1.45*reflect} -0.15 0" />
      <geometry>
        <cylinder length="0.3" radius="0.03" />
      </geometry>
    </collision>

    <collision name="${prefix}_joint">
      <origin xyz="0.58 ${1.03*reflect} 0.6" rpy="${0*reflect} -0.6 0" />
      <geometry>
        <box size="0.65 0.2 0.1" />
      </geometry>
    </collision>
  </xacro:macro>

  <link name="${namespace}/base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://wamv_description/models/iacquabot_model/base.glb" scale="1.4 1.12 1.55"/>
      </geometry>
    </visual>

    <!-- Left base collisions -->
    <xacro:main_collisions prefix="left" reflect="1" />

    <!-- Right side collisions -->
    <xacro:main_collisions prefix="right" reflect="-1" />

     <!-- Top base -->
    <collision name="top_base">
      <origin xyz="0 -0 1.25" rpy="0 0 0" />
      <geometry>
        <box size="1.85 1 0.1" />
      </geometry>
    </collision>

<inertial>
  <mass value="21.92"/>
  <inertia ixx="0.94" ixy="0.0" ixz="0.0" iyy="2.91" iyz="0.0" izz="2.59"/>
</inertial>
  </link>

  <link name="${namespace}/proa_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://wamv_description/models/iacquabot_model/proa.STL" scale="0.0013 0.0013 0.0013"/>
      </geometry>
    </visual>
  </link>

  <joint name="${namespace}/proa_joint" type="fixed">
    <origin xyz="0.45 -0.27368 -0.065" rpy="0 0 0"/>
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/proa_link"/>
  </joint>

  <!-- Decal Link attached to Tablet (Logo & Name) -->
  <link name="${namespace}/deck_decal_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.25 0.002"/>
      </geometry>
    </visual>
  </link>

  <joint name="${namespace}/deck_decal_joint" type="fixed">
    <origin xyz="0.0 0.01 -0.02" rpy="0 0 3.14159"/>
    <parent link="${namespace}/tablet_link"/>
    <child link="${namespace}/deck_decal_link"/>
  </joint>

  <gazebo>
    <enable_wind>true</enable_wind>
  </gazebo>

  <gazebo reference="${namespace}/base_link">
    <visual>
      <material>
        <ambient>0.18039 0.49020 0.19608 1.0</ambient>
        <diffuse>0.18039 0.49020 0.19608 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
        <pbr>
          <metal>
            <roughness>0.3</roughness>
            <metalness>0.3</metalness>
          </metal>
        </pbr>
      </material>
    </visual>

    <sensor type="contact" name="contact_sensor">
      <contact>
        <!-- collisions are renamed during urdf -> sdf fixed joint lumping -->
        <collision>${namespace}/base_link_fixed_joint_lump__top_base_collision_24</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_float_collision</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_mid_float_collision_1</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__left_front_float_collision_2</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_float_collision_12</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_mid_float_collision_13</collision>
        <collision>${namespace}/base_link_fixed_joint_lump__right_front_float_collision_14</collision>
        <topic>/vrx/contacts</topic>
      </contact>
      <always_on>1</always_on>
      <update_rate>5</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="${namespace}/proa_link">
    <visual>
      <material>
        <ambient>0.015 0.065 0.320 1.0</ambient>
        <diffuse>0.015 0.065 0.320 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
        <pbr>
          <metal>
            <roughness>0.3</roughness>
            <metalness>0.3</metalness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="${namespace}/deck_decal_link">
    <visual>
      <material>
        <ambient>1.0 1.0 1.0 1.0</ambient>
        <diffuse>1.0 1.0 1.0 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <pbr>
          <metal>
            <albedo_map>model://wamv_description/models/iacquabot_model/iacquabot_deck_decal.png</albedo_map>
            <roughness>0.3</roughness>
            <metalness>0.0</metalness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <!-- Tablet Link (15cm in front of camera: X=0.45, Y=0.0, Z=0.17, scale=0.096, pitch=230 deg) -->
  <link name="${namespace}/tablet_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://wamv_description/models/iacquabot_model/tablet/scene.gltf" scale="0.14 0.14 0.14"/>
      </geometry>
    </visual>
  </link>

  <joint name="${namespace}/tablet_joint" type="fixed">
    <origin xyz="0.55 0.0 0.182" rpy="0 4.01426 0"/>
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/tablet_link"/>
  </joint>

  <link name="${namespace}/solar_panel_link">
    <visual>
      <origin xyz="-0.0 3.4 -0.13" rpy="-1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://wamv_description/models/iacquabot_model/solar_panel/scene.gltf" scale="0.0162 0.01 0.011"/>
      </geometry>
    </visual>
  </link>

  <joint name="${namespace}/solar_panel_joint" type="fixed">
    <origin xyz="-0.10 0.0 0.12" rpy="0 0 0"/>
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/solar_panel_link"/>
  </joint>

  <link name="${namespace}/camera_pole_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0075" length="0.50"/>
      </geometry>
      <material name="gray_pole_mat">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="${namespace}/camera_pole_joint" type="fixed">
    <origin xyz="0.35 0.09 0.33" rpy="0 0 0"/>
    <parent link="${namespace}/base_link"/>
    <child link="${namespace}/camera_pole_link"/>
  </joint>

  <!-- Router Link (Mounted on camera pole, 0.9x narrower, 1.5x taller, face forward) -->
  <link name="${namespace}/router_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <geometry>
        <mesh filename="package://wamv_description/models/iacquabot_model/modelrouter/scene.gltf" scale="1.3 1.1 2.5"/>
      </geometry>
    </visual>
  </link>

  <joint name="${namespace}/router_joint" type="fixed">
    <origin xyz="0.035 0.0 0.25" rpy="0 0 0"/>
    <parent link="${namespace}/camera_pole_link"/>
    <child link="${namespace}/router_link"/>
  </joint>


</robot>
